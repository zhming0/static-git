# Pinned inputs for the bundle. The Dockerfile reads this file, so changing a
# line here is the whole version bump.
#
# Rule: follow one Alpine stable branch. git, curl and OpenSSH are built from
# upstream source at the exact version that branch ships; OpenSSL, zlib, expat,
# pcre2, nghttp2 and the CA bundle come from that branch's packages. The
# checksums below match the sha512sums in the branch's aports APKBUILDs.

ALPINE_VERSION=3.24

GIT_VERSION=2.54.0
GIT_SHA256=f689162364c10de79ef89aa8dbf48731eb057e34edbbd20aca510ce0154681a3

CURL_VERSION=8.22.0
CURL_SHA256=f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7

OPENSSH_VERSION=10.3p1
OPENSSH_SHA256=56682a36bb92dcf4b4f016fd8ec8e74059b79a8de25c15d670d731e7d18e45f4
