# Pinned inputs for the bundle. The Dockerfile reads this file, so changing a
# line here is the whole version bump.
#
# Rule: follow one Alpine stable branch. git, curl, OpenSSH and git-lfs are
# built from upstream source at the exact version that branch ships; OpenSSL,
# zlib, expat, pcre2, nghttp2, mimalloc and the CA bundle come from that
# branch's packages. The source tarballs are checked against each project's
# release signing key in keys/, so there is no per-version checksum to update.
# git-lfs's Go modules are checked against its go.sum.
#
# Renovate (renovate.json5) reads the "# renovate:" comments and opens a pull
# request when the Alpine branch ships a new version. depName names the branch
# (alpine_3_24); change it when moving to a new branch. Versions are written the
# way Alpine writes them, so OpenSSH is 10.3_p1; the scripts turn that into
# upstream's 10.3p1.

# renovate: datasource=docker depName=alpine
ALPINE_VERSION=3.24

# renovate: datasource=repology depName=alpine_3_24/git
GIT_VERSION=2.54.0
# renovate: datasource=repology depName=alpine_3_24/curl
CURL_VERSION=8.22.0
# renovate: datasource=repology depName=alpine_3_24/openssh
OPENSSH_VERSION=10.3_p1
# renovate: datasource=repology depName=alpine_3_24/git-lfs
GIT_LFS_VERSION=3.7.1
