#!/usr/bin/env bash
# Lint every shell script with a pinned ShellCheck release.
#
# The binary is downloaded rather than used as a step image: hosted agents did
# not start a job on the koalaman/shellcheck-alpine image.
set -euo pipefail

VERSION="v0.11.0"
SHA256="8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"

echo "--- :bash: Installing ShellCheck ${VERSION}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
curl -fsSL -o "$tmp/sc.tar.xz" \
  "https://github.com/koalaman/shellcheck/releases/download/${VERSION}/shellcheck-${VERSION}.linux.x86_64.tar.xz"
echo "${SHA256}  $tmp/sc.tar.xz" | sha256sum -c -
tar -xJf "$tmp/sc.tar.xz" -C "$tmp"

files=(scripts/*.sh .buildkite/steps/lib/*.bash test/*.sh test/gitserver/*.sh)
for f in .buildkite/steps/*; do
  [[ -f "$f" ]] && files+=("$f")
done

echo "+++ :bash: ShellCheck"
"$tmp/shellcheck-${VERSION}/shellcheck" --external-sources "${files[@]}"
